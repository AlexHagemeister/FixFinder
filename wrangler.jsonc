// Cloudflare Workers: serves the Vite build from dist/ and runs worker/index.ts for /api/* requests.
// Deploy after `bun run build`, which writes dist/. Client routes fall back to index.html.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixfinder",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker script. Everything else is a static file or the app's index.html.
    "run_worker_first": ["/api/*"]
  },
  // The record of every model call and what it cost (issue #12). Its table is in migrations/.
  "d1_databases": [
    {
      "binding": "MODEL_CALLS_DB",
      "database_name": "fixfinder-model-calls",
      "database_id": "9ee75724-b668-4c84-ae42-b936abdbc05a"
    }
  ],
  // Branch builds run `wrangler preview`. Previews do not inherit the settings above, so the database is bound here
  // too: preview calls cost real money and go in the same record as live ones. The OpenRouter key is a secret, set
  // with commands, never here (README § Keys and secrets).
  "previews": {
    "d1_databases": [
      {
        "binding": "MODEL_CALLS_DB",
        "database_name": "fixfinder-model-calls",
        "database_id": "9ee75724-b668-4c84-ae42-b936abdbc05a"
      }
    ]
  }
}
